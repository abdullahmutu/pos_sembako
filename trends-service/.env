# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Kunci rahasia untuk proteksi endpoint (dikirim Laravel via header X-API-Key).
# Kosongkan untuk menonaktifkan proteksi (tidak disarankan untuk production).
API_KEY=xK9mP2vQ7rL4nT8w

# Default geo (kode ISO) untuk /trend-score, contoh: ID, US, SG
DEFAULT_GEO=ID

# Default nama negara (huruf kecil, lengkap) untuk /trending-now
DEFAULT_PN=indonesia

# Default rentang waktu untuk /trend-score
DEFAULT_TIMEFRAME=today 3-m

DEFAULT_HL=id-ID
DEFAULT_TZ=420

BATCH_SIZE=5
RETRY_ATTEMPTS=3
RETRY_DELAY_SEC=5

PORT=5000
